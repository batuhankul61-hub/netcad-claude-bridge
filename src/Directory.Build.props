<Project>
  <!-- NETCAD 8.5 .NET Framework 4 ile çalışır; tüm projeler net48 hedefler. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Version>0.4.1</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NetcadPath Condition="'$(NetcadPath)' == ''">C:\NetCAD853</NetcadPath>
    <NetcadTools>$(NetcadPath)\TOOLS\UTILS\NETTOOLS</NetcadTools>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- NETCAD'in kendi Newtonsoft.Json kopyası (10.0): NETCAD içinde zaten yüklü, kopyalanmaz -->
    <Reference Include="Newtonsoft.Json"><HintPath>$(NetcadTools)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
